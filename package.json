{
  "name": "duis-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint --max-warnings=0",
    "build:server": "node scripts/build-server-bundles.mjs",
    "worker": "SERVICE_NAME=worker node --env-file-if-exists=.env dist/worker.mjs",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "db:up": "docker compose -f compose.dev.yaml up -d --wait",
    "db:down": "docker compose -f compose.dev.yaml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test",
    "auth:generate": "npx --yes auth@1.7.9 generate --config src/server/auth/cli-config.ts --output src/db/schema/auth.ts --yes && node scripts/postprocess-auth-schema.mjs && prettier --write src/db/schema/auth.ts",
    "db:seed": "npm run build:server && LOG_LEVEL=warn node --env-file-if-exists=.env dist/seed.mjs",
    "db:seed:photos": "npm run build:server && LOG_LEVEL=warn node --env-file-if-exists=.env dist/swap-photos.mjs",
    "db:reset": "docker compose -f compose.dev.yaml down -v && node -e \"require('node:fs').rmSync('storage/media',{recursive:true,force:true})\" && npm run db:up && npm run db:migrate",
    "admin:create": "npm run build:server && node --env-file-if-exists=.env dist/create-super-admin.mjs",
    "test:race": "playwright test -c playwright.race.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/nextjs": "11.4.0",
    "@sentry/node": "11.4.0",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.37.1",
    "pino": "^10.4.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/env": "^16.4.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "description": "Duis \u2014 self-hosted men's fashion e-commerce platform (storefront, admin, CMS)",
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
