# Server settings for the production stack: copy to /srv/duis/.env.infra
# (chmod 600) and fill in. Read by ops/compose for compose.yaml; the app
# containers never see this file. Keep a copy of every secret in the password
# manager: without PGBACKREST_CIPHER_PASS and RESTIC_PASSWORD the backups
# cannot be read. Values must not contain spaces or quotes; random hex is
# ideal (openssl rand -hex 32).

# "server" on the VPS; "local" adds compose.local.yaml (ops/local/init.sh).
DUIS_STACK=server

# --- Edge ---------------------------------------------------------------------
# Raise to 31536000 once HTTPS works everywhere (runbook: first-server-setup).
HSTS_MAX_AGE=300
# Where Nginx listens on the server.
# HTTPS_BIND=0.0.0.0:443

# --- Database roles ---------------------------------------------------------------
# Applied when the database volume is first created; changing them later is
# a rotation (runbook: secret-rotation).
POSTGRES_PASSWORD=
DUIS_OWNER_PASSWORD=
DUIS_APP_PASSWORD=
DUIS_READONLY_PASSWORD=
# The shared cache (ADR-0033); the app containers get it in REDIS_URL.
REDIS_PASSWORD=
# REDIS_MAXMEMORY=512mb
# REDIS_MEMORY=768M
# Product search (ADR-0033); the app containers get it as ELASTICSEARCH_PASSWORD.
ELASTIC_PASSWORD=
# ES_HEAP=1g
# ES_MEMORY=2G
# Sizing for 8 vCPU / 16 GB, the minimum since Phase 9 (doc/07 §1):
# Elasticsearch and Redis take ~2.6 GB, and most reads no longer reach
# Postgres, so it gets 3 GB of shared buffers rather than 4.
PG_SHARED_BUFFERS=3GB
PG_EFFECTIVE_CACHE_SIZE=8GB
# PG_MEMORY=5G
# WEB_MEMORY=1536M
# WORKER_MEMORY=1G

# --- Backups: Cloudflare R2 (doc/10: owner decision 2026-10-21) ----------------------
# Endpoint host from R2 → Overview: <account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
# An R2 API token with Object Read & Write on this bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Encrypt the backups; store both in the password manager too.
PGBACKREST_CIPHER_PASS=
RESTIC_PASSWORD=

# --- Build ----------------------------------------------------------------------
# Deploys build next to live traffic, held back so customers come first:
# CPU priority (1024 = same as the app) and a memory cap for the build.
# BUILD_CPU_SHARES=128
# BUILD_MEMORY=4g
# Same value for every build so Server Actions survive rolling deploys
# (openssl rand -base64 32).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Browser error reports (public value; the server's DSN is in .env.production).
NEXT_PUBLIC_SENTRY_DSN=
# Image CDN (Phase 10): built into the app, so it lives here; the private
# key goes in .env.production as IMAGEKIT_PRIVATE_KEY. Both set: uploads go
# to ImageKit.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
# Baked into browser error reports: production or staging.
APP_ENV=production
