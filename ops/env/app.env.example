# Application settings for the web replicas and the worker: copy to
# /srv/duis/.env.production (chmod 600) and fill in. The database URL, media
# paths and replica addresses are set by compose.yaml, not here.
# Every variable is described in .env.example.

APP_ENV=production
APP_URL=https://example.com
LOG_LEVEL=info
DATABASE_POOL_MAX=10

BETTER_AUTH_SECRET=
INTERNAL_REVALIDATE_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Duis <no-reply@example.com>"

PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SHIPPING_PROVIDER=shiprocket
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_PICKUP_PINCODE=

SMS_PROVIDER=msg91
SMS_API_KEY=
SMS_OTP_TEMPLATE_ID=
WHATSAPP_PROVIDER=off

# Server checks (doc/07 §7): who is emailed when one fails (comma-separated).
OPS_ALERT_EMAIL=
# Error reports from the server and the worker.
SENTRY_DSN=

# Optional: uncomment the ones you use. An empty value is an error, so leave
# unused ones commented out.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# GA4_MEASUREMENT_ID=
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# SENTRY_TRACES_SAMPLE_RATE=0.05
