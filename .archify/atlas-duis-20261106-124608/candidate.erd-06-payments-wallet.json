  "cards": [
    {
      "dot": "cyan",
      "title": "Payments",
      "items": [
        "payments.provider_order_id and provider_payment_id are unique; purpose is full, advance (partial COD) or exchange_difference.",
        "refunds carry a unique idempotency_key."
      ]
    },
    {
      "dot": "amber",
      "title": "Webhooks",
      "items": [
        "webhook_events is unique on (provider, event_id), which makes replays harmless.",
        "fake_gateway_records backs the fake payment gateway used in dev and tests."
      ]
    },
    {
      "dot": "rose",
      "title": "Wallet",
      "items": [
        "wallet_ledger is append-only with a unique idempotency_key.",
        "wallet_accounts.balance_paise has a CHECK >= 0.",
        "Credits are tracked as lots with an expiry; wallet_lot_usages links a debit to the lots it consumed."
      ]
    },
    {
      "dot": "slate",
