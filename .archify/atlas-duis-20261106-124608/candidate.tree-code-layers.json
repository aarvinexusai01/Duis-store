  "cards": [
    { "dot": "cyan", "title": "Import direction", "items": ["app/ and components/ call features through actions, queries or the module's index; never service, repository or db.", "A feature reaches another feature only through that feature's index.", "lib/ imports nothing from the app, features, server or db.", "Inside features/, deep relative imports (../../) are banned; use the @/ alias. sql.raw is banned across src/ (except migrations)."] },
    { "dot": "emerald", "title": "Business actions", "items": ["Mutations are Server Actions that call a defineOperation: authorize, validate with Zod, then a handler.", "Handlers write the audit row and enqueue jobs inside the same transaction.", "Money is integer paise and prices, tax, stock and permissions are decided on the server only."] },
    { "dot": "amber", "title": "Process boundaries", "items": ["The worker bundle is built from worker/ and calls feature services.", "Email templates render only in the worker; web code never imports react-dom/server.", "Builds have no database: database-backed pages sit behind connection()."] }
