  "cards": [
    {
      "dot": "cyan",
      "title": "Two paths, one outcome",
      "items": [
        "The browser callback and the webhook both end in settleCapturedPayment().",
        "It locks the payment and order, checks amount and currency, commits the reserved stock and confirms the order, once.",
        "A reconciler runs every 5 minutes for payments that neither path settled."
      ]
    },
    {
      "dot": "amber",
      "title": "Other cases",
      "items": [
        "Partial COD takes only an advance online (purpose = advance); the order becomes partially_paid with a COD balance.",
        "Unpaid orders expire after the 15 minute hold; a late payment re-reserves stock or is refunded automatically.",
        "A wallet-only order confirms immediately with no gateway call."
      ]
    },
    {
      "dot": "emerald",
      "title": "Money rules",
      "items": [
        "Amounts are integer paise; USD orders also carry the charged amount in minor units.",
        "Prices, tax, stock and coupon limits are decided on the server inside the transaction."
      ]
    }
  ]
