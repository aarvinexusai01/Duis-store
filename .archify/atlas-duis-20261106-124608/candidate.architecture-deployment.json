  "cards": [
    { "dot": "cyan", "title": "Deploy by hand", "items": ["CI runs on every pull request and push to main; nothing deploys automatically.", "The owner runs ops/deploy.sh on the VPS for a commit that passed CI.", "It builds duis-web:<sha> on the server, runs migrate (aborts everything if it fails), then replaces web_a, web_b and the worker one at a time and smoke-tests.", "A failed web replica rolls back to the previous image; ops/rollback.sh redeploys an old SHA without rebuilding."] },
    { "dot": "emerald", "title": "Backups", "items": ["pgBackRest to Cloudflare R2: weekly full (Sunday 02:30), daily differential, continuous WAL.", "restic to R2: nightly logical dump and the media volume.", "Elasticsearch and Redis are not backed up: they are copies or caches.", "A monthly restore drill proves the backups restore."] },
    { "dot": "amber", "title": "Monitoring", "items": ["UptimeRobot probes /api/health/ready and /api/health/ops (503 on failure).", "The worker's ops-check job records results in ops_checks and emails OPS_ALERT_EMAIL.", "Sentry (SaaS) receives errors from web and worker; not drawn."] }
