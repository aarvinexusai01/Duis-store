  "cards": [
    {
      "dot": "cyan",
      "title": "orders is the hub",
      "items": [
        "52 columns: money in *_paise, the charged USD amounts in *_minor, and three status fields (status, payment_status, fulfillment_status).",
        "place_idempotency_key is unique, so placing an order twice returns the same order."
      ]
    },
    {
      "dot": "amber",
      "title": "Snapshots",
      "items": [
        "order_items copies sku, title, price and tax at purchase time; variant_id and product_id are set null if the product is deleted."
      ]
    },
    {
      "dot": "rose",
      "title": "Append-only",
      "items": [
        "order_status_history, cod_remittances and order_notes are append-only.",
        "cod_remittances.shipment_id has no FK: it was dropped to break an import cycle."
      ]
    },
    {
      "dot": "slate",
      "title": "Reading this diagram",
      "items": [
        "A column typed 'uuid → table.column' is a foreign key into a table drawn in another diagram of this set.",
        "Dashed lines are optional (nullable) foreign keys."
      ]
    }
  ]
