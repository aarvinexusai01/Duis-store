  "cards": [
    {
      "dot": "cyan",
      "title": "Shipping",
      "items": [
        "shipments.direction is forward, reverse or replacement, so exchanges reuse the same table.",
        "Only one live forward shipment per order (partial unique index).",
        "shipment_tracking_events is unique on (shipment_id, provider_status, occurred_at), so repeated courier events are ignored."
      ]
    },
    {
      "dot": "amber",
      "title": "No returns table",
      "items": [
        "Returns are modelled as exchange_requests plus the RTO shipment statuses.",
        "customer_photos are private uploads shared by exchanges and reviews.",
        "A review is tied to one order_item (unique)."
      ]
    },
    {
      "dot": "slate",
      "title": "Reading this diagram",
      "items": [
        "A column typed 'uuid → table.column' is a foreign key into a table drawn in another diagram of this set.",
        "Dashed lines are optional (nullable) foreign keys."
      ]
    }
  ]
