  "cards": [
    {
      "dot": "cyan",
      "title": "Draft and published",
      "items": [
        "cms_pages, navigation_menus, site_settings and blog_posts each point at two cms_revisions rows: draft_revision_id and published_revision_id.",
        "Publishing swaps which revision is published; old revisions stay for rollback."
      ]
    },
    {
      "dot": "amber",
      "title": "Guards",
      "items": [
        "cms_revision_refs: a CHECK requires exactly one of product, collection, category or media to be set.",
        "cms_revisions.entity_id is polymorphic (page, navigation, site_settings or blog_post) with no FK.",
        "site_settings is a single row (id = 1)."
      ]
    },
