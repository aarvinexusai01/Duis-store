# Never send secrets, local artefacts or non-build files to the build context.
.env*
*.pem

.git
.github
.next
node_modules
dist
coverage
playwright-report
test-results

# Not needed to build the app image
doc
tests
# Test runners' configs import from tests/, which isn't in the context.
playwright.config.ts
vitest.config.mts
docker
compose*.yaml
Dockerfile
.dockerignore
*.md

.DS_Store
npm-debug.log*
