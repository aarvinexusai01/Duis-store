# Local development settings. Copy to .env:   cp .env.example .env
#
# The values below match compose.dev.yaml and are for LOCAL DEVELOPMENT ONLY.
# Production values exist only on the server in .env.production (chmod 600)
# and are never committed.

# --- Application -------------------------------------------------------------
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# Runtime role (DML only), used by the web app and the worker.
DATABASE_URL=postgres://duis_app:duis_app_dev_only@localhost:5432/duis
DATABASE_POOL_MAX=10
# Owner role (DDL), used only by migrations.
MIGRATION_DATABASE_URL=postgres://duis_owner:duis_owner_dev_only@localhost:5432/duis

# Role passwords applied by docker/postgres/initdb the first time the volume
# is initialised (defaults shown; changing them later needs a new volume).
# POSTGRES_PASSWORD=postgres_dev_only
# DUIS_OWNER_PASSWORD=duis_owner_dev_only
# DUIS_APP_PASSWORD=duis_app_dev_only
# DUIS_READONLY_PASSWORD=duis_readonly_dev_only

# --- Email (Mailpit in development; inbox at http://localhost:8025) ---------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Duis <no-reply@duis.local>"
MAILPIT_API_URL=http://localhost:8025

# --- Auth (Better Auth) -------------------------------------------------------
# Production: a fresh random value (openssl rand -base64 48). Rotating it signs
# everyone out.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-change-me-0123456789
# Google sign-in is enabled only when both are set (doc/10 A6).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OTP SMS: "fake" logs codes locally; "msg91" needs a DLT-approved template (doc/10 A2).
SMS_PROVIDER=fake
# SMS_API_KEY=
# SMS_OTP_TEMPLATE_ID=
# WhatsApp order updates: "off", "fake" (logs only) or "msg91" (doc/10 A3).
WHATSAPP_PROVIDER=fake
# WHATSAPP_API_KEY=
# WHATSAPP_NUMBER=919800000000
# WHATSAPP_TEMPLATE_NAMESPACE=
# WHATSAPP_WEBHOOK_TOKEN=
# Cloudflare Turnstile on login codes and sign-up; off until both are set.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Analytics, each off until set and loaded only after cookie consent. The
# Conversions API token sends Purchase from the server (needs the Pixel ID);
# the test code shows those events under Events Manager → Test events.
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# META_PIXEL_ID=
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=
# Courier rates, shipments and tracking: "fake" answers from fixed rules and
# makes demo labels (development only). For Shiprocket set "shiprocket" and the
# account values below (never commit them).
SHIPPING_PROVIDER=fake
# SHIPROCKET_API_EMAIL=
# SHIPROCKET_API_PASSWORD=
# SHIPROCKET_WEBHOOK_TOKEN=
# SHIPROCKET_PICKUP_LOCATION=Primary
# SHIPROCKET_PICKUP_PINCODE=226001

# --- Payments ------------------------------------------------------------------
# "fake" simulates the gateway (development and tests). For Razorpay TEST mode
# set PAYMENT_PROVIDER=razorpay and your test keys below; never commit them.
PAYMENT_PROVIDER=fake
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Media --------------------------------------------------------------------
# Uploaded images and their renditions (a Docker volume in production).
MEDIA_ROOT=./storage/media
MEDIA_MAX_UPLOAD_BYTES=15728640
# Private files such as shipping labels (never served publicly).
STORAGE_PRIVATE_ROOT=./storage/private

# --- Cache invalidation fan-out (internal network only) ----------------------
INTERNAL_REVALIDATE_SECRET=dev-only-revalidate-secret-change-me-0123456789
# Every web replica; in production e.g. http://web_a:3000,http://web_b:3000
INTERNAL_REVALIDATE_URLS=http://localhost:3000

# --- Shared cache (ADR-0033) ---------------------------------------------------
# Redis from compose.dev.yaml. Optional: unset, each process caches in its own
# memory and product pages read stock from Postgres. Production builds
# (npm run build && npm start, E2E) use it; `next dev` keeps its own cache.
REDIS_URL=redis://:redis_dev_only@localhost:6380/0

# --- Product search (ADR-0033) ---------------------------------------------------
# Elasticsearch from compose.dev.yaml. Optional: unset, search runs on Postgres.
# Build or rebuild the index with `npm run search:reindex`; the worker keeps
# it up to date afterwards.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_PASSWORD=elastic_dev_only

# --- Integration tests ----------------------------------------------------------
# Superuser connection used only to create the throwaway test database.
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres_dev_only@localhost:5432/postgres
TEST_DATABASE_NAME=duis_test
# Its own Redis database, emptied at the start of every run.
TEST_REDIS_URL=redis://:redis_dev_only@localhost:6380/15
# Integration tests use their own index name, rebuilt every run.
TEST_ELASTICSEARCH_INDEX=duis-products-test

# --- Operations (doc/07 §7) ------------------------------------------------------
# Who is emailed when a server check fails (comma-separated). Unset: the
# checks show on /admin/system only.
# OPS_ALERT_EMAIL=ops@example.com
# Error reports from the server and the worker (Sentry); off while unset.
# SENTRY_DSN=
# Share of requests traced for performance (0 to 1); 0 sends errors only.
# SENTRY_TRACES_SAMPLE_RATE=0

# --- Production build only ---------------------------------------------------
# Same value for every build (openssl rand -base64 32), passed as a build secret.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Browser error reports; baked into the build (ops/deploy.sh passes it).
# NEXT_PUBLIC_SENTRY_DSN=
